{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "model": "opus",
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "playground@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(gh repo create:*)",
      "PowerShell(gh repo create:*)"
    ]
  },
  "outputStyle": "Concise",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "theme": "dark-ansi",
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true
}
